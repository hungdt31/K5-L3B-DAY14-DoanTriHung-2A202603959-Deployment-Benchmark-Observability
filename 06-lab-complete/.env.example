# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# Trên Railway / Render: đặt các biến này trong phần Variables / Environment của service.
# ============================================================

# --- Server ---
PORT=8000
# development | staging | production (staging/production bắt buộc có AGENT_API_KEY)
ENVIRONMENT=development
LOG_LEVEL=INFO
# Số uvicorn worker khi chạy trong Docker
WEB_CONCURRENCY=2

# --- Secret ---
# Tạo key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# --- Redis: nơi giữ state (rate limit, chi phí). docker compose tự đặt redis://redis:6379/0 ---
REDIS_URL=redis://localhost:6379/0

# --- Giới hạn ---
# Số request tối đa trong 60 giây cho mỗi API key, vượt → 429
RATE_LIMIT_PER_MINUTE=10
# Tổng chi phí LLM tối đa mỗi ngày (UTC), vượt → 402
DAILY_BUDGET_USD=1.0
